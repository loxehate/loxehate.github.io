---
import { getCollection } from "astro:content";
import RadarReportList from "@/components/radar/RadarReportList.astro";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { groupRadarEntries, RADAR_RECENT_DAYS, recentRadarGroups } from "@/utils/radar-utils";

const entries = await getCollection("radar");
const groups = recentRadarGroups(groupRadarEntries(entries));
---

<MainGridLayout title="Big Model Radar" description="AI 生态自动追踪报告">
	<div class="card-base rounded-(--radius-large) p-6 md:p-8">
		<div class="mb-7 flex flex-col gap-3 border-b border-(--line-divider) pb-6 md:flex-row md:items-end md:justify-between">
			<div>
				<p class="mb-2 text-sm font-bold tracking-widest text-(--primary)">AI ECOSYSTEM RADAR</p>
				<h1 class="text-3xl font-bold text-90">Big Model Radar</h1>
				<p class="mt-3 text-70">覆盖 AI CLI、Agents、官方资讯、开源趋势和 Hacker News 社区动态。</p>
			</div>
			<a class="btn-regular rounded-lg px-4 py-2 font-medium" href="/radar/archive/">全部归档</a>
		</div>
		<p class="mb-6 text-sm text-60">首页展示最近 {RADAR_RECENT_DAYS} 个自然日的报告。</p>
		{groups.length > 0 ? <RadarReportList groups={groups} /> : <p>近期暂无报告。</p>}
	</div>
</MainGridLayout>
