---
import { createHash } from "node:crypto";
import { readdir, readFile } from "node:fs/promises";
import { resolve } from "node:path";
import { Icon } from "astro-icon/components";
import LocalReader from "@/components/pages/reader/LocalReader.svelte";
import { siteConfig } from "@/config";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import type { BuiltInBook } from "@/lib/reader/types";

if (!siteConfig.pages.reader) {
	return Astro.redirect("/404/");
}

const title = "本地阅读";
const description = "在浏览器中导入和阅读本地 TXT 小说，文件不会上传到服务器。";
const booksDirectory = resolve(process.cwd(), "public", "books");
const builtInBooks: BuiltInBook[] = await Promise.all(
	(await readdir(booksDirectory, { withFileTypes: true }))
		.filter((entry) => entry.isFile() && /\.(?:txt|epub)$/i.test(entry.name))
		.sort((a, b) => a.name.localeCompare(b.name, "zh-CN"))
		.map(async (entry) => {
			const data = await readFile(resolve(booksDirectory, entry.name));
			const format = entry.name.toLowerCase().endsWith(".epub")
				? "epub"
				: "txt";
			return {
				path: `books/${encodeURIComponent(entry.name)}`,
				fileName: entry.name,
				title: entry.name.replace(/\.(?:txt|epub)$/i, ""),
				format,
				hash: createHash("sha256").update(data).digest("hex"),
				fileSize: data.byteLength,
			};
		}),
);
---

<MainGridLayout title={title} description={description}>
  <div class="reader-page flex w-full rounded-(--radius-large) overflow-hidden relative min-h-32">
    <div class="card-base px-5 py-6 md:px-9 md:py-8 relative w-full">
      <div class="flex items-center gap-3 mb-7">
        <div class="h-8 w-8 rounded-lg bg-(--primary) flex items-center justify-center text-white dark:text-black/70">
          <Icon name="material-symbols:auto-stories-rounded" class="text-[1.45rem]" />
        </div>
        <div>
          <div class="text-2xl md:text-3xl font-bold text-neutral-900 dark:text-neutral-100">{title}</div>
          <p class="text-xs text-neutral-500 dark:text-neutral-400 mt-1">离线书架 · 数据仅保存在当前浏览器</p>
        </div>
      </div>
      <LocalReader {builtInBooks} client:only="svelte" />
    </div>
  </div>
</MainGridLayout>
