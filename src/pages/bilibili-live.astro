---
import { Icon } from "astro-icon/components";
import BilibiliLiveGrid from "@/components/pages/bilibili-live/BilibiliLiveGrid.svelte";
import { siteConfig } from "@/config";
import MainGridLayout from "@/layouts/MainGridLayout.astro";

if (!siteConfig.pages.bilibiliLive) {
	return Astro.redirect("/404/");
}

const rooms = siteConfig.bilibili?.liveRooms ?? [];
---

<MainGridLayout
	title="Bilibili 直播"
	description="关注的直播间、官方播放器与 Bilibili 外链"
>
	<div class="flex w-full overflow-hidden rounded-(--radius-large) relative min-h-32">
		<div class="card-base relative w-full px-4 py-5 sm:px-6 sm:py-7 md:px-9">
			<header class="mb-8 grid gap-5 border-b border-(--line-divider) pb-7 md:grid-cols-[minmax(0,1fr)_auto] md:items-end">
				<div>
					<div class="mb-3 flex items-center gap-3">
						<div class="flex h-9 w-9 items-center justify-center rounded-xl bg-(--primary) text-white dark:text-black/70">
							<Icon name="material-symbols:live-tv-rounded" class="text-[1.35rem]" />
						</div>
						<p class="m-0 font-mono text-[0.68rem] font-bold tracking-[0.16em] text-(--primary)">BILIBILI LIVE</p>
					</div>
					<h1 class="m-0 text-3xl font-bold tracking-tight text-neutral-900 dark:text-neutral-100">直播列表</h1>
					<p class="mt-3 max-w-2xl text-sm leading-relaxed text-neutral-600 dark:text-neutral-400">
						从关注的房间中选择直播。播放器仅在点击后加载；遇到浏览器限制时，可随时转到 Bilibili 官方页面。
					</p>
				</div>
				<a
					href="https://live.bilibili.com/"
					target="_blank"
					rel="noopener noreferrer"
					class="inline-flex h-10 items-center justify-center gap-2 rounded-xl border border-(--line-divider) bg-(--btn-regular-bg) px-4 text-sm font-medium text-(--btn-content) no-underline transition-all duration-200 hover:border-(--primary)/40 hover:text-(--primary) active:scale-[0.98]"
				>
					<Icon name="fa7-brands:bilibili" class="text-[1rem]" />
					打开直播首页
					<Icon name="material-symbols:arrow-outward-rounded" class="text-[1rem]" />
				</a>
			</header>

			<BilibiliLiveGrid client:load {rooms} />
		</div>
	</div>
</MainGridLayout>
